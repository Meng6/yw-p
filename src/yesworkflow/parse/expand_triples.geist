{%- use "./src/yesworkflow/parse/templates.geist" %}

{% create "yw", datastore="rdflib", inputformat="nt", isfilepath=False %}
    {@ model_triples @}
{% endcreate %}

{% load "yw", datastore="rdflib", inputformat="nt", isfilepath=False %}
    {% query "yw", datastore="rdflib", isfilepath=False as data %}
        {% prefix %}
        {% query_data %}
    {% endquery %}

    {% for dataIdx, row in data.iterrows() %}
        <https://www.openskope.org/yesworkflow/data/{{ dataIdx + 1 }}> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://www.openskope.org/yesworkflow/Data> .
        <https://www.openskope.org/yesworkflow/data/{{ dataIdx + 1 }}> <https://www.openskope.org/yesworkflow/hasName> "{{ row["name"] }}" .
        <https://www.openskope.org/yesworkflow/data/{{ dataIdx + 1 }}> <https://www.openskope.org/yesworkflow/hasQualifiedName> "{{ row["qualified_name"] }}" .
        <https://www.openskope.org/yesworkflow/data/{{ dataIdx + 1 }}> <https://www.openskope.org/yesworkflow/isParam> "{{ row["is_param"] }}" .
    {% endfor %}
{% endload %}

{% load "yw", datastore="rdflib", inputformat="nt", isfilepath=False %}
    {% query "yw", datastore="rdflib", isfilepath=False as port_connects_to_channel %}
        {% prefix %}
        {% query_port_connects_to_channel %}
    {% endquery %}
    {% set nestedblock_to_nestedblock = port_connects_to_channel[port_connects_to_channel["flag"] == "nestedblock_to_nestedblock"] %}
    {% set block_to_nestedblock = port_connects_to_channel[port_connects_to_channel["flag"] == "block_to_nestedblock"] %}
    {% set nestedblock_to_block = port_connects_to_channel[port_connects_to_channel["flag"] == "nestedblock_to_block"] %}
    
    {% for channelIdx, row in nestedblock_to_nestedblock.iterrows() %}
        <https://www.openskope.org/yesworkflow/channel/{{ channelIdx + 1 }}> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://www.openskope.org/yesworkflow/Channel> .
        <https://www.openskope.org/yesworkflow/channel/{{ channelIdx + 1 }}> <https://www.openskope.org/yesworkflow/hasPort> {{ row["port1"] }} .
        <https://www.openskope.org/yesworkflow/channel/{{ channelIdx + 1 }}> <https://www.openskope.org/yesworkflow/hasPort> {{ row["port2"] }} .
    {% endfor %}
    
    {% set curChannelIdx = nestedblock_to_nestedblock.shape[0] %}
    {% for channelIdx, row in block_to_nestedblock.iterrows() %}
        <https://www.openskope.org/yesworkflow/channel/{{ (channelIdx + 1) + curChannelIdx }}> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://www.openskope.org/yesworkflow/Channel> .
        <https://www.openskope.org/yesworkflow/channel/{{ (channelIdx + 1) + curChannelIdx }}> <https://www.openskope.org/yesworkflow/hasInflow> {{ row["port1"] }} .
        <https://www.openskope.org/yesworkflow/channel/{{ (channelIdx + 1) + curChannelIdx }}> <https://www.openskope.org/yesworkflow/hasPort> {{ row["port2"] }} .
    {% endfor %}
    
    {% set curChannelIdx = nestedblock_to_nestedblock.shape[0] + block_to_nestedblock.shape[0] %}
    {% for channelIdx, row in nestedblock_to_block.iterrows() %}
        <https://www.openskope.org/yesworkflow/channel/{{ (channelIdx + 1) + curChannelIdx }}> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://www.openskope.org/yesworkflow/Channel> .
        <https://www.openskope.org/yesworkflow/channel/{{ (channelIdx + 1) + curChannelIdx }}> <https://www.openskope.org/yesworkflow/hasPort> {{ row["port1"] }} .
        <https://www.openskope.org/yesworkflow/channel/{{ (channelIdx + 1) + curChannelIdx }}> <https://www.openskope.org/yesworkflow/hasOutflow> {{ row["port2"] }} .
    {% endfor %}
{% endload %}

{% load "yw", datastore="rdflib", inputformat="nt", isfilepath=False %}
    {% query "yw", datastore="rdflib", isfilepath=False as channel_connected_by_data %}
        {% prefix %}
        {% query_channel_connected_by_data %}
    {% endquery %}
    {% for _, row in channel_connected_by_data.iterrows() %}
        {{ row["channel"] }} <https://www.openskope.org/yesworkflow/isConnectedBy> {{ row["data"] }} .
    {% endfor %}
{% endload %}

{% load "yw", datastore="rdflib", inputformat="nt", isfilepath=False %}
    {% if "{@ workflow @}" != "DEFAULT_WORKFLOW"  %}
        {% query "yw", datastore="rdflib", isfilepath=False as workflow_block %}
            {% prefix %}
            {% query_workflow %}
        {% endquery %}
        {% set workflow_triple = workflow_block.block.values[0] + ' <https://www.openskope.org/yesworkflow/isTopLevelWorkflow> "true" .' %}
    {% else %}
        {% set workflow_triple = '<https://www.openskope.org/yesworkflow/block/1> <https://www.openskope.org/yesworkflow/isTopLevelWorkflow> "true" .' %}
    {% endif %}
    {{ workflow_triple }}
{% endload %}